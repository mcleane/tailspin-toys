---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllCategories, getAllGames, getAllPublishers } from '../lib/games';

export const prerender = true;

const db = getDatabase();
const [games, categories, publishers] = await Promise.all([
  getAllGames(db),
  getAllCategories(db),
  getAllPublishers(db),
]);
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <div class="mb-6 flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
        <div>
          <h2 class="text-2xl font-medium text-slate-100">Featured Games</h2>
          <p id="filter-results-status" class="mt-2 text-sm text-slate-400" data-testid="filter-results-status" role="status" aria-live="polite">
            Showing all {games.length} games
          </p>
        </div>

        <form
          id="game-filters"
          action="/"
          method="get"
          class="rounded-xl border border-slate-700 bg-slate-800/60 p-4 shadow-lg"
          data-testid="game-filters"
        >
          <div class="flex flex-col gap-4 xl:flex-row xl:items-end">
            <fieldset class="min-w-0">
              <legend class="mb-2 text-sm font-semibold text-slate-100">Categories</legend>
              <div class="flex flex-wrap gap-2">
                {categories.map((category) => (
                  <label
                    class="inline-flex items-center gap-2 rounded-lg border border-slate-700 bg-slate-900/70 px-3 py-2 text-sm text-slate-200 transition-colors hover:bg-slate-700 has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-blue-500 has-[:focus-visible]:outline-none"
                    data-testid="category-filter-option"
                  >
                    <input
                      type="checkbox"
                      name="category"
                      value={category.id}
                      class="h-4 w-4 rounded border-slate-600 bg-slate-900 text-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                      data-testid={`category-filter-${category.id}`}
                    />
                    <span>{category.name}</span>
                  </label>
                ))}
              </div>
            </fieldset>

            <label class="flex min-w-56 flex-col gap-2 text-sm font-semibold text-slate-100">
              Publisher
              <select
                name="publisher"
                class="rounded-lg border border-slate-700 bg-slate-900 px-3 py-2 text-sm font-normal text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                data-testid="publisher-filter"
              >
                <option value="">All publishers</option>
                {publishers.map((publisher) => (
                  <option value={publisher.id}>{publisher.name}</option>
                ))}
              </select>
            </label>

            <div class="flex gap-2">
              <button
                type="submit"
                class="rounded-lg bg-blue-600 px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                data-testid="apply-filters-button"
              >
                Apply filters
              </button>
              <a
                href="/"
                class="rounded-lg border border-slate-600 px-4 py-2 text-sm font-semibold text-slate-200 transition-colors hover:bg-slate-700 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                data-testid="clear-filters-link"
              >
                Clear
              </a>
            </div>
          </div>
        </form>
      </div>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <>
          <div class="hidden" data-testid="filtered-empty-state" id="filtered-empty-state">
            <EmptyState text="No games match the selected filters. Clear filters to see every game." />
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="games-grid">
            {games.map((game) => <GameCard game={game} />)}
          </div>
        </>
      )}
    </div>
  </div>
</Layout>

<script>
  const filtersForm = document.querySelector<HTMLFormElement>('[data-testid="game-filters"]');
  const categoryInputs = Array.from(document.querySelectorAll<HTMLInputElement>('input[name="category"]'));
  const publisherSelect = document.querySelector<HTMLSelectElement>('[data-testid="publisher-filter"]');
  const gameCards = Array.from(document.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));
  const filteredEmptyState = document.querySelector<HTMLElement>('#filtered-empty-state');
  const filterResultsStatus = document.querySelector<HTMLElement>('#filter-results-status');

  function getSelectedCategoryIds(): Set<string> {
    return new Set(categoryInputs.filter((input) => input.checked).map((input) => input.value));
  }

  function applyFilters(): void {
    const selectedCategoryIds = getSelectedCategoryIds();
    const selectedPublisherId = publisherSelect?.value ?? '';
    let visibleCount = 0;

    for (const card of gameCards) {
      const matchesCategory = selectedCategoryIds.size === 0 || selectedCategoryIds.has(card.dataset.categoryId ?? '');
      const matchesPublisher = selectedPublisherId === '' || card.dataset.publisherId === selectedPublisherId;
      const isVisible = matchesCategory && matchesPublisher;

      card.classList.toggle('hidden', !isVisible);
      if (isVisible) {
        visibleCount += 1;
      }
    }

    filteredEmptyState?.classList.toggle('hidden', visibleCount !== 0);
    if (filterResultsStatus) {
      const filtersActive = selectedCategoryIds.size > 0 || selectedPublisherId !== '';
      filterResultsStatus.textContent = filtersActive
        ? `Showing ${visibleCount} of ${gameCards.length} games`
        : `Showing all ${gameCards.length} games`;
    }
  }

  function updateUrl(): void {
    const params = new URLSearchParams();
    for (const input of categoryInputs) {
      if (input.checked) {
        params.append('category', input.value);
      }
    }

    if (publisherSelect?.value) {
      params.set('publisher', publisherSelect.value);
    }

    const query = params.toString();
    window.history.replaceState(null, '', query ? `/?${query}` : '/');
  }

  function restoreFiltersFromUrl(): void {
    const params = new URLSearchParams(window.location.search);
    const selectedCategoryIds = new Set(params.getAll('category'));
    const selectedPublisherId = params.get('publisher') ?? '';

    for (const input of categoryInputs) {
      input.checked = selectedCategoryIds.has(input.value);
    }

    if (publisherSelect) {
      const hasPublisherOption = Array.from(publisherSelect.options).some((option) => option.value === selectedPublisherId);
      publisherSelect.value = hasPublisherOption ? selectedPublisherId : '';
    }
  }

  restoreFiltersFromUrl();
  applyFilters();

  filtersForm?.addEventListener('submit', (event) => {
    event.preventDefault();
    updateUrl();
    applyFilters();
  });
</script>
